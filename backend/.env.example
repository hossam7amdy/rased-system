# ============================================================
# Rased Backend — environment variables
# Copy to .env and fill in real values. Do NOT commit .env.
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rased
DB_USER=postgres
DB_PASSWORD=

# JWT (auth tokens)
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# QR token signing (AES-256-GCM). Required, min 32 chars — tokens are
# forgeable if this leaks, so use a strong random value.
QR_SECRET=change_me_qr_signing_secret
# QR rotation cadence and token lifetime (ms). Validity must exceed rotation.
QR_ROTATION_MS=8000
QR_VALIDITY_MS=20000

# Redis (optional). If REDIS_HOST is unset or unreachable, the app falls
# back to an in-memory cache automatically.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
