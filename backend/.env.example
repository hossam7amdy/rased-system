# ============================================================
# Rased Backend — environment variables
# Copy to .env and fill in real values. Do NOT commit .env.
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rased
DB_USER=postgres
DB_PASSWORD=

# JWT (auth tokens)
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# QR token signing (AES-256-GCM). Set a strong random value in production —
# tokens are forgeable if this is left at the built-in fallback.
QR_SECRET=change_me_qr_signing_secret

# Redis (optional). If REDIS_HOST is unset or unreachable, the app falls
# back to an in-memory cache automatically.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
