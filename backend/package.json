{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Rased Attendance System Backend API",
  "type": "module",
  "main": "server.ts",
  "engines": {
    "node": ">=22.6.0"
  },
  "engineStrict": true,
  "scripts": {
    "start": "node --experimental-strip-types server.ts",
    "dev": "node --watch --enable-source-maps --experimental-strip-types server.ts",
    "typecheck": "tsc --noEmit",
    "init-db": "node --experimental-strip-types scripts/init-db.ts",
    "test": "echo \"no tests yet!\"; exit 0",
    "test:int": "node --env-file=.env.test --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "redis": "^4.6.7",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "zod": "^4.4.3"
  },
  "packageManager": "yarn@1.22.22"
}
