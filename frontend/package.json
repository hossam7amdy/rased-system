{
	"name": "rased-frontend",
	"version": "1.0.0",
	"description": "Rased Attendance System Frontend",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"build": "vite build",
		"preview": "yarn build && wrangler dev",
		"deploy": "yarn build && wrangler deploy",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:unit": "node --test \"src/**/*.test.mjs\"",
		"verify": "biome check . && tsc --noEmit && vitest run && node --test \"src/**/*.test.mjs\""
	},
	"dependencies": {
		"axios": "^1.6.2",
		"date-fns": "^3.0.0",
		"html5-qrcode": "^2.3.8",
		"lucide-react": "^0.294.0",
		"qrcode": "^1.5.3",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-router-dom": "^6.20.0",
		"recharts": "^2.10.3",
		"xlsx": "^0.18.5",
		"zustand": "^4.4.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@cloudflare/vite-plugin": "^1.0.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^18.2.43",
		"@types/react-dom": "^18.2.17",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.16",
		"jsdom": "^29.1.1",
		"postcss": "^8.4.32",
		"tailwindcss": "^3.3.6",
		"typescript": "^6.0.3",
		"vite": "^6.0.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.0.0"
	},
	"packageManager": "yarn@1.22.22"
}
