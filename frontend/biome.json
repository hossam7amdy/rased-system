{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "ignoreUnknown": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noDescendingSpecificity": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "node:test": "Use vitest (unit) or @playwright/test (e2e), not node:test.",
              "node:assert": "Use vitest expect, not node:assert.",
              "node:assert/strict": "Use vitest expect, not node:assert."
            }
          }
        }
      },
      "a11y": {
        "useButtonType": "warn",
        "noLabelWithoutControl": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noUnknownAtRules": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  }
}
